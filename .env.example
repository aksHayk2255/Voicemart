# VoiceMart Environment Configuration

# Database
# Default: SQLite in local directory. To use PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/voicemart
DATABASE_URL=sqlite:///./voicemart.db

# Authentication
JWT_SECRET=voicemart_super_secret_jwt_key_2026_btech_project

# Optional Gemini AI API Integration
# VoiceMart runs 100% locally with rule-based NLP intent detection.
# If you wish to enable optional Gemini LLM query expansion:
GEMINI_API_KEY=

